<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
    </startup>

  <system.diagnostics>
    <trace autoflush="true" indentsize="4">
      <listeners>
        <!-- remove default if you don't want DuplicateConsole/DefaultListener -->
        <remove name="Default" />

        <!-- type must be Namespace.ClassName, AssemblyName -->
        <add name="Timestamped"
             type="ReadEnvoy.TimestampedTextWriterTraceListener, ReadEnvoy"
             initializeData="TextWriterOutput.log" />
      </listeners>
    </trace>
  </system.diagnostics>  
</configuration>
